		<PackageReference Include="System.Linq.Async" Version="7.0.1" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\..\Common\Contract\Common.Contract\Common.Contract.csproj" />
	  <ProjectReference Include="..\..\Common\Readers\Common.Readers.XmlReader\Common.Readers.BaseXmlReader.csproj" />
	  <ProjectReference Include="..\..\Pohoda\Pohoda.Contract\Pohoda.Contract.csproj" />
	  <ProjectReference Include="..\..\Pohoda\Pohoda.Server\Pohoda.Server.csproj" />
	</ItemGroup>

</Project>
